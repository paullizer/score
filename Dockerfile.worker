FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npx tsc -p tsconfig.worker.json && npm run build:worker
RUN node --input-type=module -e "import { readFileSync, writeFileSync } from 'node:fs'; import { createHash } from 'node:crypto'; const artifacts = Object.fromEntries(['worker', 'runtime', 'grade-worker', 'grade-runtime', 'resume-worker', 'resume-runtime', 'analysis-worker', 'analysis-runtime', 'word-parser'].map(name => [name + '.mjs', createHash('sha256').update(readFileSync('dist-worker/' + name + '.mjs')).digest('hex')])); writeFileSync('dist-worker/word-imports.json', JSON.stringify({ schemaVersion: 1, capability: 'word-document-imports-v1', runtimeSettingsVersion: 'score-runtime-settings-v1', artifacts }))"

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build --chown=node:node /app/dist-worker ./dist-worker
USER node
CMD ["node", "dist-worker/worker.mjs"]
